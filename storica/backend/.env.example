# Application
DEBUG=false
SECRET_KEY=change-me-in-production

# Database (The Archives)
DATABASE_URL=postgresql+asyncpg://storica:storica@localhost:5432/storica

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# JWT
JWT_SECRET_KEY=jwt-secret-change-in-production

# LLM
GEMINI_API_KEY=your-gemini-api-key-here

# Stage-based model routing (optional - these are the defaults)
# Available models: gemini-1.5-flash, gemini-1.5-pro, gemini-2.0-flash
# MODEL_ESSENCE=gemini-2.0-flash       # Philosophical foundation
# MODEL_ARCHITECTURE=gemini-2.0-flash  # Narrative structure
# MODEL_BLUEPRINT=gemini-2.0-flash     # Chapter outlines
# MODEL_CHAPTER=gemini-2.0-flash       # Prose draft generation
# MODEL_STORY_BIBLE=gemini-2.0-flash   # Continuity tracking
# MODEL_PREVALIDATION=gemini-2.0-flash # Blueprint validation
# MODEL_CRITIQUE=gemini-2.0-flash      # Self-review of draft
# MODEL_POLISH=gemini-2.0-flash        # Revision based on critique

# Context window settings (optional - these are the defaults)
# CONTEXT_PREVIOUS_CHAPTERS=5          # Number of previous chapters to include
# CONTEXT_CHARACTERS_LIMIT=15          # Max characters to show in prompts
# CONTEXT_PREVIOUS_ENDING_CHARS=1500   # Chars from previous chapter ending

# CORS (comma-separated origins)
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173"]
