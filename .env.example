# Storica Environment Variables

# Security
SECRET_KEY=change-me-in-production-use-a-long-random-string
JWT_SECRET_KEY=jwt-secret-change-in-production-use-a-long-random-string

# Gemini API
GEMINI_API_KEY=your-gemini-api-key-here

# Database (only override if not using Docker Compose defaults)
# DATABASE_URL=postgresql+asyncpg://litai:litai@localhost:5432/litai

# Redis (only override if not using Docker Compose defaults)
# REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=redis://localhost:6379/1
# CELERY_RESULT_BACKEND=redis://localhost:6379/2
