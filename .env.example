# Storica Environment Configuration
# Copy this to .env and fill in your values

# Database
DATABASE_URL=sqlite:///./storica.db
# For PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/storica

# Redis (for Celery)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# JWT Authentication
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Anthropic API (Claude)
ANTHROPIC_API_KEY=sk-ant-your-api-key-here
CLAUDE_MODEL_DEFAULT=claude-sonnet-4-20250514
CLAUDE_MODEL_PROSE=claude-opus-4-20250514

# Pipeline Settings
PIPELINE_MAX_ITERATIONS=3
PIPELINE_PASSING_THRESHOLD=7.0
PIPELINE_APPROVAL_TIMEOUT_SECONDS=3600

# Cost Limits (USD)
MAX_COST_PER_PROJECT=50.0
WARN_COST_THRESHOLD=25.0

# CORS (comma-separated origins)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
